import {
    Todo,
    todo_add,
    todo_toggle,
    todo_delete,
    todo_get,
    todo_slot_count,
    todo_at,
    str_starts_with,
    url_suffix,
    url_param_int
} from "todo.or"

extern printf(fmt: string, args: ...anything) => int32

// HTTP runtime (only C dependency)
extern http_send(conn: &int8, status: int32, content_type: string, body: string) => int32

// JSON helpers
fn json_ok(message: string) => string {
    return "{\"status\": \"ok\", \"message\": \"" + message + "\"}"
}

fn json_error(message: string) => string {
    return "{\"error\": \"" + message + "\"}"
}

fn json_int(key: string, value: int32) => string {
    return "{\"" + key + "\": " + str(value) + "}"
}

fn todo_to_json(t: Todo) => string {
    var done_str = "false"
    if t.done == 1 {
        done_str = "true"
    }
    return "{\"id\": " + str(t.id) + ", \"title\": \"" + t.title + "\", \"done\": " + done_str + "}"
}

fn send_json(conn: &int8, status: int32, body: string) => int32 {
    return http_send(conn, status, "application/json", body)
}

export fn route_index(conn: &int8) => int32 {
    return http_send(conn, 200, "text/plain",
        "Orlang HTTP Server - Todo REST API\n\nGET  /health\nGET  /stats\nGET  /todos\nGET  /todos/:id\nPOST /todos/add/:title\nPOST /todos/toggle/:id\nPOST /todos/delete/:id\n")
}

export fn route_health(conn: &int8) => int32 {
    return send_json(conn, 200, json_ok("healthy"))
}

export fn route_stats(conn: &int8, request_count: int32) => int32 {
    return send_json(conn, 200, json_int("requests", request_count))
}

export fn route_todo_list(conn: &int8) => int32 {
    var result = "["
    var first: int32 = 1
    var slots = todo_slot_count()
    for var i = 0; i < slots; i = i + 1 {
        var t = todo_at(i)
        if t.active == 1 {
            if first == 0 {
                result = result + ", "
            }
            result = result + todo_to_json(t)
            first = 0
        }
    }
    return send_json(conn, 200, result + "]")
}

export fn route_todo_get(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/")
    if id < 0 {
        return send_json(conn, 400, json_error("invalid id"))
    }
    var t = todo_get(id)
    if t.id < 0 {
        return send_json(conn, 404, json_error("not found"))
    }
    return send_json(conn, 200, todo_to_json(t))
}

export fn route_todo_add(conn: &int8, url: string) => int32 {
    var title: string = url_suffix(url, "/todos/add/")
    if title == "" {
        return send_json(conn, 400, json_error("title required"))
    }
    var t = todo_add(title)
    if t.id < 0 {
        return send_json(conn, 500, json_error("storage full"))
    }
    return send_json(conn, 201, json_int("id", t.id))
}

export fn route_todo_toggle(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/toggle/")
    if todo_toggle(id) == 1 {
        return send_json(conn, 200, json_ok("toggled"))
    }
    return send_json(conn, 404, json_error("not found"))
}

export fn route_todo_delete(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/delete/")
    if todo_delete(id) == 1 {
        return send_json(conn, 200, json_ok("deleted"))
    }
    return send_json(conn, 404, json_error("not found"))
}

export fn route_not_found(conn: &int8) => int32 {
    return send_json(conn, 404, json_error("not found"))
}

extern printf(fmt: string, args: ...anything) => int32

// HTTP runtime (from http.c)
extern http_send(conn: &int8, status: int32, content_type: string, body: string) => int32

// String helpers
extern str_eq(a: string, b: string) => int32
extern str_starts_with(s: string, prefix: string) => int32

// JSON formatting
extern json_ok(message: string) => string
extern json_error(message: string) => string
extern json_int(key: string, value: int32) => string

// Todo storage (backed by C)
extern todo_add(title: string) => int32
extern todo_toggle(id: int32) => int32
extern todo_delete(id: int32) => int32
extern todo_get(id: int32) => string
extern todo_list() => string
extern todo_count() => int32

// URL parsing
extern url_param_int(url: string, prefix: string) => int32

var request_count: int32 = 0

fn send_json(conn: &int8, status: int32, body: string) => int32 {
    return http_send(conn, status, "application/json", body)
}

fn route_index(conn: &int8) => int32 {
    return http_send(conn, 200, "text/plain",
        "Orlang HTTP Server\n\nEndpoints:\n  GET  /health\n  GET  /stats\n  GET  /todos\n  POST /todos/add/:title\n  POST /todos/toggle/:id\n  POST /todos/delete/:id\n  GET  /todos/:id\n")
}

fn route_health(conn: &int8) => int32 {
    return send_json(conn, 200, json_ok("healthy"))
}

fn route_stats(conn: &int8) => int32 {
    return send_json(conn, 200, json_int("requests", request_count))
}

fn route_todo_list(conn: &int8) => int32 {
    return send_json(conn, 200, todo_list())
}

fn route_todo_get(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/")
    if id < 0 {
        return send_json(conn, 400, json_error("invalid id"))
    }
    var item: string = todo_get(id)
    if str_eq(item, "") == 1 {
        return send_json(conn, 404, json_error("not found"))
    }
    return send_json(conn, 200, item)
}

fn route_todo_add(conn: &int8, url: string) => int32 {
    var title: string = url + 11
    var id: int32 = todo_add(title)
    if id < 0 {
        return send_json(conn, 500, json_error("storage full"))
    }
    return send_json(conn, 201, json_int("id", id))
}

fn route_todo_toggle(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/toggle/")
    if todo_toggle(id) == 1 {
        return send_json(conn, 200, json_ok("toggled"))
    }
    return send_json(conn, 404, json_error("not found"))
}

fn route_todo_delete(conn: &int8, url: string) => int32 {
    var id: int32 = url_param_int(url, "/todos/delete/")
    if todo_delete(id) == 1 {
        return send_json(conn, 200, json_ok("deleted"))
    }
    return send_json(conn, 404, json_error("not found"))
}

export fn handle_request(method: string, url: string, conn: &int8) => int32 {
    request_count = request_count + 1
    printf("  %s %s\n", method, url)

    if str_eq(method, "GET") == 1 {
        if str_eq(url, "/") == 1 {
            return route_index(conn)
        }
        if str_eq(url, "/health") == 1 {
            return route_health(conn)
        }
        if str_eq(url, "/stats") == 1 {
            return route_stats(conn)
        }
        if str_eq(url, "/todos") == 1 {
            return route_todo_list(conn)
        }
        if str_starts_with(url, "/todos/") == 1 {
            return route_todo_get(conn, url)
        }
    }

    if str_eq(method, "POST") == 1 {
        if str_starts_with(url, "/todos/add/") == 1 {
            return route_todo_add(conn, url)
        }
        if str_starts_with(url, "/todos/toggle/") == 1 {
            return route_todo_toggle(conn, url)
        }
        if str_starts_with(url, "/todos/delete/") == 1 {
            return route_todo_delete(conn, url)
        }
    }

    return send_json(conn, 404, json_error("not found"))
}

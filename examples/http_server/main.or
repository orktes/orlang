// A JSON todo API built entirely on the orlang standard library.
//
// Build and run (no external dependencies, just clang on PATH):
//   orlang run main.or
//
// Try it:
//   curl http://localhost:8080/
//   curl http://localhost:8080/todos
//   curl -X POST -d '{"title": "write more orlang"}' http://localhost:8080/todos
//   curl -X POST -d '{"id": 1}' http://localhost:8080/todos/toggle
//   curl http://localhost:8080/health

import { server, Request, Response } from "std/http.or"
import { parse, object, array, number, text, boolean, Json } from "std/json.or"

// In-memory todo store: parallel slices indexed by id-1
var titles: []string
var completed: []bool

fn todo_json(id: int32) => Json {
    var item = object()
    item.set("id", number(float64(id)))
    item.set("title", text(titles[id - 1]))
    item.set("done", boolean(completed[id - 1]))
    return item
}

fn main() {
    var app = server()

    app.get("/", fn (req: Request, res: Response) => void {
        res.send("orlang todo API — GET /todos, POST /todos, POST /todos/toggle\n")
    })

    app.get("/health", fn (req: Request, res: Response) => void {
        var out = object()
        out.set("status", text("ok"))
        out.set("todos", number(float64(len(titles))))
        res.json(out.stringify())
    })

    app.get("/todos", fn (req: Request, res: Response) => void {
        var list = array()
        for var i = 0; i < len(titles); i++ {
            list.push(todo_json(i + 1))
        }
        res.json(list.stringify())
    })

    app.post("/todos", fn (req: Request, res: Response) => void {
        var body = parse(req.body())
        var title = body.get("title")
        if !title.valid() {
            res.status(400)
            var err = object()
            err.set("error", text("expected {\"title\": \"...\"}"))
            res.json(err.stringify())
        } else {
            titles = append(titles, title.str())
            completed = append(completed, false)
            res.status(201)
            res.json(todo_json(len(titles)).stringify())
        }
    })

    app.post("/todos/toggle", fn (req: Request, res: Response) => void {
        var body = parse(req.body())
        var id = int32(body.get("id").num())
        if id < 1 || id > len(titles) {
            res.status(404)
            var err = object()
            err.set("error", text("no such todo"))
            res.json(err.stringify())
        } else {
            completed[id - 1] = !completed[id - 1]
            res.json(todo_json(id).stringify())
        }
    })

    println("listening on http://localhost:8080")
    app.listen(8080)
}

extern printf(fmt: string, args: ...anything) => int32

fn main() {
    var a: int32 = 10

    a += 5
    printf("a += 5: %d\n", a)

    a -= 3
    printf("a -= 3: %d\n", a)

    a *= 2
    printf("a *= 2: %d\n", a)

    a /= 4
    printf("a /= 4: %d\n", a)

    a %= 2
    printf("a %%= 2: %d\n", a)
}

extern printf(fmt: string, args: ...anything) => int32

fn main() {
    // Test break: print 0,1,2 then break at 3
    for var a = 0; a < 10; a++ {
        if a == 3 {
            break
        }
        printf("%d\n", a)
    }

    // Test continue: skip b==1 and b==3
    for var b = 0; b < 5; b++ {
        if b == 1 {
            continue
        }
        if b == 3 {
            continue
        }
        printf("%d\n", b)
    }

    // Test break in nested loop: inner loop breaks at d==1
    for var c = 0; c < 3; c++ {
        for var d = 0; d < 3; d++ {
            if d == 1 {
                break
            }
            printf("%d-%d\n", c, d)
        }
    }

    printf("done\n")
}
